{
  "name": "laxmi",
  "productName": "Laxmi",
  "version": "1.0.0",
  "description": "Local-first, open-source, opinionated personal finance management software.",
  "main": "dist/main.js",
  "type": "commonjs",
  "author": "Kevin Alappat",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinalappat09/laxmi.git"
  },
  "homepage": "https://github.com/kevinalappat09/laxmi",
  "bugs": {
    "url": "https://github.com/kevinalappat09/laxmi/issues"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "finance",
    "local-first",
    "desktop",
    "electron",
    "accounting"
  ],
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --prefix renderer run dev",
    "predev:electron": "npm run rebuild:native",
    "dev:electron": "concurrently \"tsc -w\" \"wait-on http://localhost:5173 && electron dist/main.js\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm --prefix renderer run build",
    "build:electron": "tsc",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "predist": "npm run build",
    "dist": "electron-builder --publish never",
    "predist:win": "npm run build",
    "dist:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "predist:linux": "npm run build",
    "dist:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --publish never",
    "verify": "npm run build && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:run": "jest --runInBand",
    "postinstall": "npm run rebuild:native"
  },
